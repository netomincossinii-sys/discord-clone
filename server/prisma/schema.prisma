// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  TEXT
  VOICE
}

enum UserStatus {
  ONLINE
  IDLE
  DND
  INVISIBLE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  color        String
  createdAt    DateTime @default(now())

  bio               String?
  avatarImage       String?
  bannerColor       String    @default("#f37108")
  activityText      String?
  activityStartedAt DateTime?
  interestTags      String[] @default([])
  status            UserStatus @default(ONLINE)

  memberships Membership[]
  messages    Message[]

  sentFriendRequests     Friendship[]     @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]     @relation("FriendshipAddressee")
  dmConversationsAsA     DmConversation[] @relation("DmConversationA")
  dmConversationsAsB     DmConversation[] @relation("DmConversationB")
  dmMessages             DmMessage[]
  ownedServers           Server[]         @relation("ServerOwner")
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model DmConversation {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA    User        @relation("DmConversationA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User        @relation("DmConversationB", fields: [userBId], references: [id], onDelete: Cascade)
  messages DmMessage[]

  @@unique([userAId, userBId])
}

model DmMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  attachmentUrl  String?
  attachmentName String?
  attachmentType String?

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Server {
  id      String @id @default(uuid())
  name    String
  icon    String
  ownerId String?

  inviteCode          String?   @unique
  inviteCodeCreatedAt DateTime?

  owner       User?        @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  channels    Channel[]
  memberships Membership[]
}

model Membership {
  id       String @id @default(uuid())
  userId   String
  serverId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
}

model Channel {
  id       String      @id @default(uuid())
  name     String
  type     ChannelType @default(TEXT)
  serverId String

  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  channelId String
  authorId  String

  attachmentUrl  String?
  attachmentName String?
  attachmentType String?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
