// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  TEXT
  VOICE
}

enum UserStatus {
  ONLINE
  IDLE
  DND
  INVISIBLE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  googleId     String?  @unique
  passwordHash String
  color        String
  createdAt    DateTime @default(now())

  bio               String?
  avatarImage       String?
  bannerColor       String    @default("#f37108")
  bannerImage       String?
  activityText      String?
  activityStartedAt DateTime?
  interestTags      String[] @default([])
  status            UserStatus @default(ONLINE)

  memberships Membership[]
  messages    Message[]

  sentFriendRequests     Friendship[]     @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]     @relation("FriendshipAddressee")
  dmConversationsAsA     DmConversation[] @relation("DmConversationA")
  dmConversationsAsB     DmConversation[] @relation("DmConversationB")
  dmMessages             DmMessage[]
  ownedServers           Server[]         @relation("ServerOwner")
  blocksMade             Block[]          @relation("BlockBlocker")
  blocksReceived         Block[]          @relation("BlockBlocked")
  passwordResetTokens    PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model DmConversation {
  id          String   @id @default(uuid())
  userAId     String
  userBId     String
  createdAt   DateTime @default(now())
  hiddenForA  Boolean  @default(false)
  hiddenForB  Boolean  @default(false)

  userA    User        @relation("DmConversationA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User        @relation("DmConversationB", fields: [userBId], references: [id], onDelete: Cascade)
  messages DmMessage[]

  @@unique([userAId, userBId])
}

model DmMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  attachmentUrl  String?
  attachmentName String?
  attachmentType String?

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Server {
  id          String  @id @default(uuid())
  name        String
  icon        String
  iconImage   String?
  bannerColor String?
  bannerImage String?
  ownerId     String?

  inviteCode          String?   @unique
  inviteCodeCreatedAt DateTime?

  owner       User?        @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  channels    Channel[]
  memberships Membership[]
  categories  Category[]
  roles       Role[]
}

model Membership {
  id       String @id @default(uuid())
  userId   String
  serverId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  roles  MembershipRole[]

  @@unique([userId, serverId])
}

model Category {
  id       String @id @default(uuid())
  name     String
  serverId String

  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels Channel[]
}

model Role {
  id       String  @id @default(uuid())
  name     String
  color    String
  isAdmin  Boolean @default(false)
  serverId String

  server        Server              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  memberships   MembershipRole[]
  channelAccess ChannelRoleAccess[]
}

model MembershipRole {
  id           String @id @default(uuid())
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
}

model ChannelRoleAccess {
  id        String @id @default(uuid())
  channelId String
  roleId    String

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([channelId, roleId])
}

model Channel {
  id         String      @id @default(uuid())
  name       String
  type       ChannelType @default(TEXT)
  serverId   String
  categoryId String?

  server     Server              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category   Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages   Message[]
  roleAccess ChannelRoleAccess[]
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  channelId String
  authorId  String

  attachmentUrl  String?
  attachmentName String?
  attachmentType String?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
