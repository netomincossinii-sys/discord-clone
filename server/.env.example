DATABASE_URL="postgresql://user:password@localhost:5432/discord_clone?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4001
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Optional: Cloudflare Realtime TURN credentials, used to relay voice/video/screen-share
# when peers can't connect directly (different networks/NAT). Falls back to STUN-only
# (works only on the same network) when unset.
CF_TURN_TOKEN_ID=""
CF_TURN_API_TOKEN=""
